# QosQanat — Play Market (production) құрастыру айнымалылары
#
# Қолданылуы:
#   flutter build appbundle --release --dart-define-from-file=release.env
#   flutter build apk       --release --dart-define-from-file=release.env
#
# ҮЛГІ ФАЙЛ. Көшіріп ал да, бос мәндерді толтыр:
#   cp release.env.example release.env
# Нақты release.env git-ке кірмейді (құпия DSN ұстайды).
#
# Қол қою кілттері бөлек: android/key.properties (ол да git-ке кірмейді).

# Sentry-де құрастыруларды ажырату белгісі: production | pilot | dev
QOSQANAT_ENV=production

# Дүкенге шығатын жария құрастыру. true болса — келісім берілмейінше
# қосымша серверге ЕШНӘРСЕ жібермейді (толық офлайн жұмыс істейді).
QOSQANAT_PUBLIC_BUILD=true

# Пилот мектептердің ата-ана келісімі расталған құрастыру ғана true болады.
# Play Market-тегі жалпы нұсқада ӘРҚАШАН false.
QOSQANAT_PILOT_CONSENT=false

# «Демо» жапсырмалары — дүкен нұсқасында өшулі.
QOSQANAT_DEMO_LABELS=false

# Backend API. Бос қалса қосымша толық офлайн режимде жүреді
# (рейтинг/турнир/достар жергілікті деректермен жұмыс істейді).
# Сервер шыққанда толтыр: https://api.qosqanat.kz
QOSQANAT_API_URL=

# ML сервисі (дауыс/STT). Бос қалса құрылғының өз қозғалтқышы қолданылады.
QOSQANAT_ML_URL=

# Sentry DSN. Бос қалса мониторинг мүлде іске қосылмайды.
# Толтыру: https://<key>@<org>.ingest.sentry.io/<project>
QOSQANAT_SENTRY_DSN=
