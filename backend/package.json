{
  "name": "qosqanat-api",
  "version": "2.0.0",
  "description": "Enterprise-grade AI Tutor API for QosQanat - Kazakh educational platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js --watch src",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src",
    "format": "prettier --write 'src/**/*.js'",
    "start:production": "NODE_ENV=production node src/server.js",
    "health-check": "curl -f http://localhost:3000/api/health || exit 1"
  },
  "keywords": [
    "ai",
    "tutor",
    "kazakh",
    "education",
    "voice",
    "chatbot",
    "claude",
    "anthropic"
  ],
  "author": "QosQanat Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "axios": "^1.6.5",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.52.7",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
